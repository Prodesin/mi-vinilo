{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": true, "noEmit": true, "skipLibCheck": true,
    "noUnusedLocals": false, "paths": { "react": ["./node_modules/preact/compat"] }
  },
  "include": ["src"]
}
